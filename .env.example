# === Gemini API ===
GEMINI_API_KEY=your-gemini-api-key-here

# === Elasticsearch MCP Server ===
# Path to the Elastic MCP server entry point (npm package)
ELASTIC_MCP_SERVER_CMD=npx
ELASTIC_MCP_SERVER_ARGS=-y,@elastic/mcp-server-elasticsearch

# Elastic connection details (passed as env to the MCP server process)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=your-elastic-api-key-here

# === Model Configuration (optional overrides) ===
# KERNEL_MODEL=gemini-3.5-flash
# ROUTER_MODEL=gemini-3.1-flash-lite

# === Memory Daemon ===
# COMPRESSION_THRESHOLD=10
# ELASTIC_INDEX=agent_os_memory
